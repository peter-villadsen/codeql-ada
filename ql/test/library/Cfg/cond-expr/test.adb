--  CFG conformance: conditional expressions.
--  Covers an if expression with an elsif part and a case expression. Both
--  branch like their statement forms but converge on a value.
--  See docs/cfg-design.md, "Conditional expressions".
procedure Cond_Expr (A, B : Boolean; N : in out Integer) is
begin
   N := (if A then 1 elsif B then 2 else 3);  -- $ edge=AssignStmt@7:4|successor|after:AssignStmt@7:4 edge=ElsifExprPart@7:22|successor|Identifier@7:28 edge=Identifier@7:13|false|after-false:Identifier@7:13 edge=Identifier@7:13|true|after-true:Identifier@7:13 edge=Identifier@7:28|false|after-false:Identifier@7:28 edge=Identifier@7:28|true|after-true:Identifier@7:28 edge=Identifier@7:4|successor|AssignStmt@7:4 edge=IfExpr@7:10|successor|Identifier@7:13 edge=IntLiteral@7:20|successor|after:IfExpr@7:10 edge=IntLiteral@7:35|successor|after:IfExpr@7:10 edge=IntLiteral@7:42|successor|after:IfExpr@7:10 edge=ParenExpr@7:9|successor|after:ParenExpr@7:9 edge=after-false:Identifier@7:13|successor|ElsifExprPart@7:22 edge=after-false:Identifier@7:28|successor|IntLiteral@7:42 edge=after-true:Identifier@7:13|successor|IntLiteral@7:20 edge=after-true:Identifier@7:28|successor|IntLiteral@7:35 edge=after:AssignStmt@7:4|successor|before:AssignStmt@9:4 edge=after:IfExpr@7:10|successor|ParenExpr@7:9 edge=after:ParenExpr@7:9|successor|Identifier@7:4 edge=before:AssignStmt@7:4|successor|before:ParenExpr@7:9 edge=before:ParenExpr@7:9|successor|IfExpr@7:10

   N := (case N is when 0 => 10, when others => 20);  -- $ edge=AlternativesList@9:25|match|after-true:AlternativesList@9:25 edge=AlternativesList@9:25|no-match|after-false:AlternativesList@9:25 edge=AlternativesList@9:39|match|after-true:AlternativesList@9:39 edge=AssignStmt@9:4|successor|after:AssignStmt@9:4 edge=CaseExpr@9:10|successor|Identifier@9:15 edge=CaseExprAlternative@9:20|successor|AlternativesList@9:25 edge=CaseExprAlternative@9:34|successor|AlternativesList@9:39 edge=Identifier@9:15|successor|CaseExprAlternative@9:20 edge=Identifier@9:4|successor|AssignStmt@9:4 edge=IntLiteral@9:30|successor|after:CaseExpr@9:10 edge=IntLiteral@9:49|successor|after:CaseExpr@9:10 edge=ParenExpr@9:9|successor|after:ParenExpr@9:9 edge=StmtList@7:4|successor|before:AssignStmt@7:4 edge=after-false:AlternativesList@9:25|no-match|after-false:CaseExprAlternative@9:20 edge=after-false:CaseExprAlternative@9:20|successor|CaseExprAlternative@9:34 edge=after-true:AlternativesList@9:25|match|after-true:CaseExprAlternative@9:20 edge=after-true:AlternativesList@9:39|match|after-true:CaseExprAlternative@9:34 edge=after-true:CaseExprAlternative@9:20|successor|IntLiteral@9:30 edge=after-true:CaseExprAlternative@9:34|successor|IntLiteral@9:49 edge=after:AssignStmt@9:4|successor|after:StmtList@7:4 edge=after:CaseExpr@9:10|successor|ParenExpr@9:9 edge=after:ParenExpr@9:9|successor|Identifier@9:4 edge=after:StmtList@7:4|successor|after:HandledStmts@6:6 edge=before:AssignStmt@9:4|successor|before:ParenExpr@9:9 edge=before:ParenExpr@9:9|successor|CaseExpr@9:10
end Cond_Expr;  -- $ edge=HandledStmts@6:6|successor|StmtList@7:4 edge=after:HandledStmts@6:6|successor|exitSubpBody(normal)@5:1 edge=enterSubpBody@5:1|successor|HandledStmts@6:6 edge=exitSubpBody(normal)@5:1|successor|exitSubpBody@5:1
