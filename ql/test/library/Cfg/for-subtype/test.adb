--  CFG conformance: a for loop over a subtype indication.
--  The range expression is evaluated, then the indication, then the loop as usual.
--  See docs/cfg-design.md, "Loops".
procedure For_Subtype (N : Integer; X : in out Integer) is
begin
   for I in Natural range 0 .. N loop  -- $ edge=BinOp@6:27|successor|after:BinOp@6:27 edge=DefiningName@6:8|successor|StmtList@7:7 edge=DiscreteSubtypeIndication@6:13|empty|after-true:DiscreteSubtypeIndication@6:13 edge=DiscreteSubtypeIndication@6:13|non-empty|after-false:DiscreteSubtypeIndication@6:13 edge=Identifier@6:32|successor|BinOp@6:27 edge=IntLiteral@6:27|successor|Identifier@6:32 edge=after-false:DiscreteSubtypeIndication@6:13|successor|DefiningName@6:8 edge=after-true:DiscreteSubtypeIndication@6:13|successor|after:ForLoopStmt@6:4 edge=after:BinOp@6:27|successor|DiscreteSubtypeIndication@6:13 edge=before:BinOp@6:27|successor|IntLiteral@6:27 edge=before:DiscreteSubtypeIndication@6:13|successor|before:BinOp@6:27
      X := I;  -- $ edge=AssignStmt@7:7|successor|after:AssignStmt@7:7 edge=Identifier@7:12|successor|Identifier@7:7 edge=Identifier@7:7|successor|AssignStmt@7:7 edge=StmtList@7:7|successor|before:AssignStmt@7:7 edge=after:AssignStmt@7:7|successor|after:StmtList@7:7 edge=after:StmtList@7:7|successor|add.[LoopHeader]:ForLoopStmt@6:4 edge=before:AssignStmt@7:7|successor|Identifier@7:12
   end loop;  -- $ edge=ForLoopStmt@6:4|successor|before:DiscreteSubtypeIndication@6:13 edge=add.[LoopHeader]:ForLoopStmt@6:4|successor|DefiningName@6:8 edge=add.[LoopHeader]:ForLoopStmt@6:4|successor|after:ForLoopStmt@6:4 edge=after:ForLoopStmt@6:4|successor|before:AssignStmt@9:4
   X := 0;  -- $ edge=AssignStmt@9:4|successor|after:AssignStmt@9:4 edge=Identifier@9:4|successor|AssignStmt@9:4 edge=IntLiteral@9:9|successor|Identifier@9:4 edge=StmtList@6:4|successor|ForLoopStmt@6:4 edge=after:AssignStmt@9:4|successor|after:StmtList@6:4 edge=after:StmtList@6:4|successor|after:HandledStmts@5:6 edge=before:AssignStmt@9:4|successor|IntLiteral@9:9
end For_Subtype;  -- $ edge=HandledStmts@5:6|successor|StmtList@6:4 edge=after:HandledStmts@5:6|successor|exitSubpBody(normal)@4:1 edge=enterSubpBody@4:1|successor|HandledStmts@5:6 edge=exitSubpBody(normal)@4:1|successor|exitSubpBody@4:1
