/** Gets the source text of token node `n` (an identifier, literal or operator). */
string tokenText(Raw::AdaNode n) {
  result = n.(Raw::CharLiteral).getValue()
  or
  result = n.(Raw::Identifier).getValue()
  or
  result = n.(Raw::IntLiteral).getValue()
  or
  result = n.(Raw::NullLiteral).getValue()
  or
  result = n.(Raw::OpAbs).getValue()
  or
  result = n.(Raw::OpAnd).getValue()
  or
  result = n.(Raw::OpAndThen).getValue()
  or
  result = n.(Raw::OpConcat).getValue()
  or
  result = n.(Raw::OpDiv).getValue()
  or
  result = n.(Raw::OpDoubleDot).getValue()
  or
  result = n.(Raw::OpEq).getValue()
  or
  result = n.(Raw::OpGt).getValue()
  or
  result = n.(Raw::OpGte).getValue()
  or
  result = n.(Raw::OpIn).getValue()
  or
  result = n.(Raw::OpLt).getValue()
  or
  result = n.(Raw::OpLte).getValue()
  or
  result = n.(Raw::OpMinus).getValue()
  or
  result = n.(Raw::OpMod).getValue()
  or
  result = n.(Raw::OpMult).getValue()
  or
  result = n.(Raw::OpNeq).getValue()
  or
  result = n.(Raw::OpNot).getValue()
  or
  result = n.(Raw::OpNotIn).getValue()
  or
  result = n.(Raw::OpOr).getValue()
  or
  result = n.(Raw::OpOrElse).getValue()
  or
  result = n.(Raw::OpPlus).getValue()
  or
  result = n.(Raw::OpPow).getValue()
  or
  result = n.(Raw::OpRem).getValue()
  or
  result = n.(Raw::OpXor).getValue()
  or
  result = n.(Raw::RealLiteral).getValue()
  or
  result = n.(Raw::StringLiteral).getValue()
}
