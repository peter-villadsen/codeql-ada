  | @ada_op_or
  | @ada_op_or_else
  | @ada_op_plus
  | @ada_op_pow
  | @ada_op_rem
  | @ada_op_xor

@ada_overriding_node =
    @ada_overriding_not_overriding
  | @ada_overriding_overriding
  | @ada_overriding_unspecified

@ada_pp_directive =
    @ada_pp_else_directive
  | @ada_pp_elsif_directive
  | @ada_pp_end_if_directive
  | @ada_pp_if_directive

@ada_private_node =
    @ada_private_absent
  | @ada_private_present

@ada_protected_node =
    @ada_protected_absent
  | @ada_protected_present

@ada_quantifier =
    @ada_quantifier_all
  | @ada_quantifier_some

@ada_real_type_def =
    @ada_decimal_fixed_point_def
  | @ada_floating_point_def
  | @ada_ordinary_fixed_point_def

@ada_renaming_clause_or_sub =
    @ada_renaming_clause
  | @ada_synthetic_renaming_clause

@ada_reverse_node =
    @ada_reverse_absent
  | @ada_reverse_present

@ada_simple_stmt =
    @ada_abort_stmt
  | @ada_assign_stmt
  | @ada_call_stmt
  | @ada_delay_stmt
  | @ada_exit_stmt
  | @ada_goto_stmt
  | @ada_label
