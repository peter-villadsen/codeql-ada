--  CFG conformance: for loops, both the range form and the iterator form.
--  See docs/cfg-design.md, "For loops".
--
--  The iteration mechanism is opaque (D-013): the iterable is evaluated once,
--  then control may enter the body or skip the loop entirely, and after each
--  iteration may loop again or leave.
procedure Loops_For (N : in out Integer) is
   type Vec is array (1 .. 3) of Integer;
   V : Vec := (others => 0);  -- $ edge=Aggregate@9:15|successor|after:Aggregate@9:15 edge=AggregateAssoc@9:16|successor|after:AggregateAssoc@9:16 edge=AssocList@9:16|successor|after:AssocList@9:16 edge=IntLiteral@9:26|successor|AggregateAssoc@9:16 edge=after:Aggregate@9:15|successor|HandledStmts@10:6 edge=after:AggregateAssoc@9:16|successor|AssocList@9:16 edge=after:AssocList@9:16|successor|Aggregate@9:15 edge=before:Aggregate@9:15|successor|before:AssocList@9:16 edge=before:AggregateAssoc@9:16|successor|IntLiteral@9:26 edge=before:AssocList@9:16|successor|before:AggregateAssoc@9:16
begin
   for I in 1 .. 3 loop  -- $ edge=BinOp@11:13|empty|after-true:BinOp@11:13 edge=BinOp@11:13|non-empty|after-false:BinOp@11:13 edge=DefiningName@11:8|successor|StmtList@12:7 edge=IntLiteral@11:13|successor|IntLiteral@11:18 edge=IntLiteral@11:18|successor|BinOp@11:13 edge=after-false:BinOp@11:13|successor|DefiningName@11:8 edge=after-true:BinOp@11:13|successor|after:ForLoopStmt@11:4 edge=before:BinOp@11:13|successor|IntLiteral@11:13
      N := N + I;  -- $ edge=AssignStmt@12:7|successor|after:AssignStmt@12:7 edge=BinOp@12:12|successor|after:BinOp@12:12 edge=Identifier@12:12|successor|Identifier@12:16 edge=Identifier@12:16|successor|BinOp@12:12 edge=Identifier@12:7|successor|AssignStmt@12:7 edge=StmtList@12:7|successor|before:AssignStmt@12:7 edge=after:AssignStmt@12:7|successor|after:StmtList@12:7 edge=after:BinOp@12:12|successor|Identifier@12:7 edge=after:StmtList@12:7|successor|add.[LoopHeader]:ForLoopStmt@11:4 edge=before:AssignStmt@12:7|successor|before:BinOp@12:12 edge=before:BinOp@12:12|successor|Identifier@12:12
   end loop;  -- $ edge=ForLoopStmt@11:4|successor|before:BinOp@11:13 edge=add.[LoopHeader]:ForLoopStmt@11:4|successor|DefiningName@11:8 edge=add.[LoopHeader]:ForLoopStmt@11:4|successor|after:ForLoopStmt@11:4 edge=after:ForLoopStmt@11:4|successor|ForLoopStmt@15:4

   for E of V loop  -- $ edge=DefiningName@15:8|successor|StmtList@16:7 edge=Identifier@15:13|empty|after-true:Identifier@15:13 edge=Identifier@15:13|non-empty|after-false:Identifier@15:13 edge=after-false:Identifier@15:13|successor|DefiningName@15:8 edge=after-true:Identifier@15:13|successor|after:ForLoopStmt@15:4
      N := N + E;  -- $ edge=AssignStmt@16:7|successor|after:AssignStmt@16:7 edge=BinOp@16:12|successor|after:BinOp@16:12 edge=Identifier@16:12|successor|Identifier@16:16 edge=Identifier@16:16|successor|BinOp@16:12 edge=Identifier@16:7|successor|AssignStmt@16:7 edge=StmtList@16:7|successor|before:AssignStmt@16:7 edge=after:AssignStmt@16:7|successor|after:StmtList@16:7 edge=after:BinOp@16:12|successor|Identifier@16:7 edge=after:StmtList@16:7|successor|add.[LoopHeader]:ForLoopStmt@15:4 edge=before:AssignStmt@16:7|successor|before:BinOp@16:12 edge=before:BinOp@16:12|successor|Identifier@16:12
   end loop;  -- $ edge=ForLoopStmt@15:4|successor|Identifier@15:13 edge=StmtList@11:4|successor|ForLoopStmt@11:4 edge=add.[LoopHeader]:ForLoopStmt@15:4|successor|DefiningName@15:8 edge=add.[LoopHeader]:ForLoopStmt@15:4|successor|after:ForLoopStmt@15:4 edge=after:ForLoopStmt@15:4|successor|after:StmtList@11:4 edge=after:StmtList@11:4|successor|after:HandledStmts@10:6
end Loops_For;  -- $ edge=HandledStmts@10:6|successor|StmtList@11:4 edge=after:HandledStmts@10:6|successor|exitSubpBody(normal)@7:1 edge=enterSubpBody@7:1|successor|before:Aggregate@9:15 edge=exitSubpBody(normal)@7:1|successor|exitSubpBody@7:1
