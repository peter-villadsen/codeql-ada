  | @ada_raise_stmt
  | @ada_requeue_stmt
  | @ada_return_stmt
  | @ada_simple_decl_stmt
  | @ada_terminate_alternative

@ada_single_tok_node =
    @ada_base_id
  | @ada_null_literal
  | @ada_num_literal

@ada_stmt =
    @ada_composite_stmt
  | @ada_error_stmt
  | @ada_simple_stmt

@ada_subp_kind =
    @ada_subp_kind_function
  | @ada_subp_kind_procedure

@ada_subtype_indication_or_sub =
    @ada_subtype_indication
  | @ada_constrained_subtype_indication
  | @ada_discrete_subtype_indication

@ada_synchronized_node =
    @ada_synchronized_absent
  | @ada_synchronized_present

@ada_tagged_node =
    @ada_tagged_absent
  | @ada_tagged_present

@ada_task_type_decl_or_sub =
    @ada_task_type_decl
  | @ada_single_task_type_decl

@ada_type_decl =
    @ada_anonymous_type_decl_or_sub
  | @ada_concrete_type_decl
  | @ada_formal_type_decl

@ada_type_def =
    @ada_access_def
  | @ada_array_type_def
  | @ada_derived_type_def
  | @ada_enum_type_def
  | @ada_formal_discrete_type_def
  | @ada_interface_type_def
  | @ada_mod_int_type_def
  | @ada_private_type_def
  | @ada_real_type_def
  | @ada_record_type_def
  | @ada_signed_int_type_def

@ada_type_expr =
    @ada_anonymous_type
  | @ada_enum_lit_synth_type_expr
  | @ada_subtype_indication_or_sub
  | @ada_synthetic_type_expr

@ada_until_node =
    @ada_until_absent
  | @ada_until_present

@ada_use_clause =
    @ada_use_package_clause
  | @ada_use_type_clause

@ada_with_private =
    @ada_with_private_absent
  | @ada_with_private_present

