--  CFG conformance: short-circuit operators.
--  Covers "and then", "or else", a nested combination, and plain "and" for
--  contrast. See docs/cfg-design.md, "Short-circuit operators".
procedure Short_Circuit (A, B, C : Boolean; N : out Integer) is
begin
   if A and then B then  -- $ edge=BinOp@6:7|successor|Identifier@6:7 edge=Identifier@6:18|false|after-false:Identifier@6:18 edge=Identifier@6:18|true|after-true:Identifier@6:18 edge=Identifier@6:7|false|after-false:Identifier@6:7 edge=Identifier@6:7|true|after-true:Identifier@6:7 edge=after-false:BinOp@6:7|successor|after:IfStmt@6:4 edge=after-false:Identifier@6:18|false|after-false:BinOp@6:7 edge=after-false:Identifier@6:7|false|after-false:BinOp@6:7 edge=after-true:BinOp@6:7|successor|StmtList@7:7 edge=after-true:Identifier@6:18|true|after-true:BinOp@6:7 edge=after-true:Identifier@6:7|successor|Identifier@6:18
      N := 1;  -- $ edge=AssignStmt@7:7|successor|after:AssignStmt@7:7 edge=Identifier@7:7|successor|AssignStmt@7:7 edge=IntLiteral@7:12|successor|Identifier@7:7 edge=StmtList@7:7|successor|before:AssignStmt@7:7 edge=after:AssignStmt@7:7|successor|after:StmtList@7:7 edge=after:StmtList@7:7|successor|after:IfStmt@6:4 edge=before:AssignStmt@7:7|successor|IntLiteral@7:12
   end if;  -- $ edge=IfStmt@6:4|successor|BinOp@6:7 edge=after:IfStmt@6:4|successor|IfStmt@10:4

   if A or else B then  -- $ edge=BinOp@10:7|successor|Identifier@10:7 edge=Identifier@10:17|false|after-false:Identifier@10:17 edge=Identifier@10:17|true|after-true:Identifier@10:17 edge=Identifier@10:7|false|after-false:Identifier@10:7 edge=Identifier@10:7|true|after-true:Identifier@10:7 edge=after-false:BinOp@10:7|successor|after:IfStmt@10:4 edge=after-false:Identifier@10:17|false|after-false:BinOp@10:7 edge=after-false:Identifier@10:7|successor|Identifier@10:17 edge=after-true:BinOp@10:7|successor|StmtList@11:7 edge=after-true:Identifier@10:17|true|after-true:BinOp@10:7 edge=after-true:Identifier@10:7|true|after-true:BinOp@10:7
      N := 2;  -- $ edge=AssignStmt@11:7|successor|after:AssignStmt@11:7 edge=Identifier@11:7|successor|AssignStmt@11:7 edge=IntLiteral@11:12|successor|Identifier@11:7 edge=StmtList@11:7|successor|before:AssignStmt@11:7 edge=after:AssignStmt@11:7|successor|after:StmtList@11:7 edge=after:StmtList@11:7|successor|after:IfStmt@10:4 edge=before:AssignStmt@11:7|successor|IntLiteral@11:12
   end if;  -- $ edge=IfStmt@10:4|successor|BinOp@10:7 edge=after:IfStmt@10:4|successor|IfStmt@14:4

   if A and then (B or else C) then  -- $ edge=BinOp@14:19|successor|Identifier@14:19 edge=BinOp@14:7|successor|Identifier@14:7 edge=Identifier@14:19|false|after-false:Identifier@14:19 edge=Identifier@14:19|true|after-true:Identifier@14:19 edge=Identifier@14:29|successor|after:BinOp@14:19 edge=Identifier@14:7|false|after-false:Identifier@14:7 edge=Identifier@14:7|true|after-true:Identifier@14:7 edge=ParenExpr@14:18|false|after-false:ParenExpr@14:18 edge=ParenExpr@14:18|true|after-true:ParenExpr@14:18 edge=after-false:BinOp@14:7|successor|after:IfStmt@14:4 edge=after-false:Identifier@14:19|successor|Identifier@14:29 edge=after-false:Identifier@14:7|false|after-false:BinOp@14:7 edge=after-false:ParenExpr@14:18|false|after-false:BinOp@14:7 edge=after-true:BinOp@14:7|successor|StmtList@15:7 edge=after-true:Identifier@14:19|successor|after:BinOp@14:19 edge=after-true:Identifier@14:7|successor|before:ParenExpr@14:18 edge=after-true:ParenExpr@14:18|true|after-true:BinOp@14:7 edge=after:BinOp@14:19|successor|ParenExpr@14:18 edge=before:ParenExpr@14:18|successor|BinOp@14:19
      N := 3;  -- $ edge=AssignStmt@15:7|successor|after:AssignStmt@15:7 edge=Identifier@15:7|successor|AssignStmt@15:7 edge=IntLiteral@15:12|successor|Identifier@15:7 edge=StmtList@15:7|successor|before:AssignStmt@15:7 edge=after:AssignStmt@15:7|successor|after:StmtList@15:7 edge=after:StmtList@15:7|successor|after:IfStmt@14:4 edge=before:AssignStmt@15:7|successor|IntLiteral@15:12
   end if;  -- $ edge=IfStmt@14:4|successor|BinOp@14:7 edge=after:IfStmt@14:4|successor|IfStmt@18:4

   if A and B then  -- $ edge=BinOp@18:7|false|after-false:BinOp@18:7 edge=BinOp@18:7|true|after-true:BinOp@18:7 edge=Identifier@18:13|successor|BinOp@18:7 edge=Identifier@18:7|successor|Identifier@18:13 edge=after-false:BinOp@18:7|successor|after:IfStmt@18:4 edge=after-true:BinOp@18:7|successor|StmtList@19:7 edge=before:BinOp@18:7|successor|Identifier@18:7
      N := 4;  -- $ edge=AssignStmt@19:7|successor|after:AssignStmt@19:7 edge=Identifier@19:7|successor|AssignStmt@19:7 edge=IntLiteral@19:12|successor|Identifier@19:7 edge=StmtList@19:7|successor|before:AssignStmt@19:7 edge=after:AssignStmt@19:7|successor|after:StmtList@19:7 edge=after:StmtList@19:7|successor|after:IfStmt@18:4 edge=before:AssignStmt@19:7|successor|IntLiteral@19:12
   end if;  -- $ edge=IfStmt@18:4|successor|before:BinOp@18:7 edge=StmtList@6:4|successor|IfStmt@6:4 edge=after:IfStmt@18:4|successor|after:StmtList@6:4 edge=after:StmtList@6:4|successor|after:HandledStmts@5:6
end Short_Circuit;  -- $ edge=HandledStmts@5:6|successor|StmtList@6:4 edge=after:HandledStmts@5:6|successor|exitSubpBody(normal)@4:1 edge=enterSubpBody@4:1|successor|HandledStmts@5:6 edge=exitSubpBody(normal)@4:1|successor|exitSubpBody@4:1
