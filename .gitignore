# CodeQL databases and build artifacts
*.testproj
test-db/
*-db/
.cache/
corpus-report.json

# Release packaging output (scripts/create-extractor-pack.sh)
/extractor-pack/
/codeql-extractor-ada-linux64.tar.gz

# Generated by `codeql pack install`/`publish` (release.yml). Ignored by
# default, but the three pack lock files ARE committed: since Phase 7 (D-013)
# ql/lib depends on the published codeql/controlflow pack, so these locks pin
# shared-pack versions (controlflow 2.0.35, util 2.0.38) and must be tracked
# for reproducible builds. Local peter-villadsen/* deps are still resolved via
# --additional-packs and contribute nothing to the lock.
codeql-pack.lock.yml
!ql/lib/codeql-pack.lock.yml
!ql/src/codeql-pack.lock.yml
!ql/test/codeql-pack.lock.yml
.codeql/

# Python
__pycache__/
*.py[cod]
.venv/

# Ada / GNAT
obj/
*.ali
*.o

# Editors
.vscode/
.idea/

# ql/lib's lock file is generated, not committed. The VS Code extension's "View AST"
# treats a library pack's lock file as its own temporary file (`codeql pack packlist`
# never lists lock files) and deletes it after every run, which used to delete the
# committed one. qlpack.yml pins every dependency exactly, and `codeql pack install
# ql/lib` regenerates the same lock file, even from an empty cache (checked 2026-10-09);
# CI and release.yml run it before anything compiles.
/ql/lib/codeql-pack.lock.yml
